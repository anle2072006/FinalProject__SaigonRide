@model FinalProject__SaigonRide.Models.ApplicationUser
@{
    ViewData["Title"] = "Settings";
}

<div class="settings-wrapper">
    
    <div class="settings-col">
        <div class="st-card text-center profile-card">
            <div class="profile-img" style="background-color: #141627; display: flex; align-items: center; justify-content: center;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#8a8a9e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <h3 class="profile-name">@Model.FirstName @Model.LastName</h3>
            <p class="profile-email">@Model.Email</p>
        </div>

        <div class="st-card info-card">
            <h4 class="st-card-title">Information</h4>
            <ul class="info-list">
                <li><strong>Name:</strong> <span>@Model.FirstName @Model.LastName</span></li>
                <li><strong>Email:</strong> <span>@Model.Email</span></li>
                <li>
                    <strong>@(Model.IsForeigner ? "Passport:" : "Tel:")</strong>
                    <span class="text-neon">@(string.IsNullOrEmpty(Model.DocumentNumber) ? "Chưa cập nhật" : Model.DocumentNumber)</span>
                </li>
            </ul>
        </div>

        <div class="mt-3 text-center">
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">
                <button type="submit" class="btn-logout-red w-100">
                    Log out
                </button>
            </form>
        </div>
    </div>

    <div class="settings-col col-main">
        <div class="st-card h-100 form-card">
            <h3 class="st-section-title">User Settings</h3>
            
            <div class="form-section">
                <h4 class="st-card-title">Details</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" value="@Model.FirstName" placeholder="Your First Name..." />
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" value="@Model.LastName" placeholder="Your Last Name..." />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" value="@Model.Email" readonly style="background-color: #2c2e3e; color: #8a8a9e; cursor: not-allowed;" title="Không thể đổi Email" />
                    </div>
                    @if (Model.IsForeigner)
                    {
                        <div class="form-group">
                            <label>Passport Number</label>
                            <input type="text" value="@Model.DocumentNumber" placeholder="Enter your Passport..." />
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Tel - Number</label>
                            <div class="phone-input-group">
                                <input type="text" class="input-prefix" value="+84" readonly />
                                <input type="text" class="input-phone" value="@Model.DocumentNumber" placeholder="969 123 456" />
                            </div>
                        </div>
                    }
                </div>
                <button class="btn-neon">Save changes</button>
            </div>

            <div class="form-section mt-5">
                <h4 class="st-card-title">Password</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Change password</label>
                        <input type="password" placeholder="Put your password..." />
                    </div>
                    <div class="form-group">
                        <label class="invisible-label">Confirm password</label>
                        <input type="password" placeholder="Confirm password..." />
                    </div>
                    <div class="form-group">
                        <label>New password</label>
                        <input type="password" placeholder="Put your new password..." />
                    </div>
                    <div class="form-group">
                        <label class="invisible-label">Confirm new</label>
                        <input type="password" placeholder="Confirm new password..." />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn-neon">Save changes</button>
                    <button class="btn-transparent">Forgot your password?</button>
                </div>
            </div>
        </div>
    </div>

    
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/setting.css" asp-append-version="true" />
}