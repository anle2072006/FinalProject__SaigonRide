@model FinalProject__SaigonRide.Models.PaymentViewModel

<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 800px;">
        <div class="modal-content" style="background-color: transparent; border: none;">
            
            <div class="payment-container" style="padding: 40px 60px;">
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <h2 class="text-neon text-center mt-0">PAYMENT</h2>

                <div class="section-card">
                    <h3 class="section-title text-neon">Customer Information</h3>
                    <div class="grid-2">
                        <div class="grid-item"><span>First Name:</span> @Model.FirstName</div>
                        <div class="grid-item"><span>Last Name:</span> @Model.LastName</div>
                        <div class="grid-item"><span>Email:</span> @Model.Email</div>
                        <div class="grid-item"><span>Phone:</span> @Model.Phone</div>
                    </div>
                </div>

                <div class="section-card">
                    <h3 class="section-title text-neon">Order Summary</h3>
                    <div class="grid-2">
                        <div class="grid-item"><span>Pickup:</span> @Model.PickupStation</div>
                        <div class="grid-item"><span>Drop-off:</span> @Model.DropoffStation</div>
                        <div class="grid-item"><span>Vehicles:</span> @Model.RentedVehicle</div>
                        <div class="grid-item"><span>Estimated Cost:</span> <span id="originalCostText" data-cost="0">0 VND</span></div>
                    </div>
                </div>

                <div class="section-card">
                    <h3 class="section-title text-neon">Apply Coupon</h3>
                    <div class="coupon-flex">
                        <select id="couponSelect" class="coupon-input" style="cursor: pointer;">
                            <option value="0" disabled selected hidden>Select coupon</option>
                            @if (Model.AvailableCoupons != null)
                            {
                                foreach (var coupon in Model.AvailableCoupons)
                                {
                                    <option value="@coupon.DiscountValue">@coupon.CodeName (-@coupon.DiscountValue.ToString("#,##0") VND)</option>
                                }
                            }
                        </select>
                        <button type="button" id="btnApplyCoupon" class="btn-neon">Apply</button>
                    </div>

                    <div id="couponErrorMsg" style="display: none; color: #ff4d4d; font-size: 0.85rem; font-weight: bold; margin-bottom: 10px; padding-left: 5px;">
                        Please choose a discount coupon!
                    </div>
                    <div id="couponMsg" class="coupon-msg" style="display: none;"></div>
                </div>

                <div class="section-card" style="width: 100%;">
                    <h3 class="section-title text-neon">Payment Method</h3>
                    <div class="payment-methods" style="display: flex; gap: 15px; flex-wrap: wrap;">
                        <div class="pm-logo" id="pay_paypal" onclick="selectPaymentMethod('PayPal')">
                            <img src="~/images/paypal.jpg" alt="PayPal" />
                        </div>
                        <div class="pm-logo" id="pay_visa" onclick="selectPaymentMethod('Visa')">
                            <img src="~/images/visa.jpg" alt="Visa" />
                        </div>
                        <div class="pm-logo" id="pay_momo" onclick="selectPaymentMethod('MoMo')">
                            <img src="~/images/momo.jpg" alt="MoMo" />
                        </div>
                        <div class="pm-logo" id="pay_vnpay" onclick="selectPaymentMethod('VNPay')">
                            <img src="~/images/vnpay.jpg" alt="VNPay" />
                        </div>
                    </div>
                    <div id="paymentError" style="display:none; color: #ff4d4d; font-size: 0.85rem; font-weight: bold; margin-top: 10px;">
                        Vui lòng chọn phương thức thanh toán!
                    </div>
                </div>

                <div class="footer-flex">
                    <div class="total-text">
                        Total: <span id="totalDisplay" class="text-neon">0 VND</span>
                    </div>
    
                    <form id="paymentForm" asp-controller="Payment" asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="amount" id="finalAmountInput" />
                        <input type="hidden" name="paymentMethod" id="selectedMethodInput" />
                        <button type="button" onclick="handlePaymentSubmit()" class="btn-neon" style="padding: 12px 25px;">Payment Confirmation</button>
                    </form>
                </div>

                <script>
                    let selectedMethod = "";

                    function selectPaymentMethod(method) {
                        selectedMethod = method;
                        document.getElementById("selectedMethodInput").value = method;
        
                        document.querySelectorAll('.pm-logo').forEach(el => el.classList.remove('selected'));
                        document.getElementById('pay_' + method.toLowerCase()).classList.add('selected');
                        document.getElementById("paymentError").style.display = "none";
                    }

                    function handlePaymentSubmit() {
                        if (!selectedMethod) {
                            document.getElementById("paymentError").style.display = "block";
                            return;
                        }

                        const totalStr = document.getElementById("totalDisplay").innerText;

                        document.getElementById("finalAmountInput").value = totalStr;
                        document.getElementById("paymentForm").submit();
                    }
                </script>
            </div>
        </div>
    </div>
</div>

<script>
    function lamTronTien(soTien) {
        return Math.round(soTien / 1000) * 1000;
    }

    function updateModalWithLiveCost(realTimeCost) {
        var costElement = document.getElementById("originalCostText");
        costElement.setAttribute("data-cost", realTimeCost);
        costElement.innerText = realTimeCost.toLocaleString("vi-VN") + " VND";
        calculateFinalTotal();
    }

    // 3. FIX LOGIC COUPON: Cập nhật hàm tính toán chính xác
    function calculateFinalTotal() {
        var costElement = document.getElementById("originalCostText");
        var baseCost = parseInt(costElement.getAttribute("data-cost")) || 0;
        
        var select = document.getElementById("couponSelect");
        var btnApply = document.getElementById("btnApplyCoupon");
        var discountValue = 0;

        // Kiểm tra nếu trạng thái nút là Applied thì mới trừ tiền
        if (btnApply.innerText.trim() === "Applied") {
            discountValue = parseInt(select.value) || 0;
        }

        var finalTotal = baseCost - discountValue;
        if (finalTotal < 0) finalTotal = 0;

        var roundedTotal = lamTronTien(finalTotal);
        document.getElementById("totalDisplay").innerText = roundedTotal.toLocaleString("vi-VN") + " VND";
    }

    document.addEventListener("DOMContentLoaded", function () {
        var select = document.getElementById("couponSelect");
        var btnApply = document.getElementById("btnApplyCoupon");
        var msg = document.getElementById("couponMsg");
        var errorMsg = document.getElementById("couponErrorMsg");

        if (!select || !btnApply) return;

        function resetCouponState() {
            select.value = "0";
            btnApply.innerText = "Apply";
            btnApply.style.backgroundColor = "#cbfb45";
            btnApply.style.color = "#1a1b2f";
            msg.style.display = "none";
            errorMsg.style.display = "none";
            calculateFinalTotal();
        }

        btnApply.addEventListener("click", function () {
            // Nếu đã Apply rồi thì bấm lại để hủy
            if (btnApply.innerText.trim() === "Applied") {
                resetCouponState();
                return;
            }

            var discountValue = parseInt(select.value);
            if (!isNaN(discountValue) && discountValue > 0) {
                var couponText = select.options[select.selectedIndex].text;
                
                btnApply.innerText = "Applied";
                btnApply.style.backgroundColor = "#ff4d4d";
                btnApply.style.color = "#ffffff";
                msg.innerText = "Using " + couponText;
                msg.style.display = "block";
                errorMsg.style.display = "none";

                calculateFinalTotal();
            } else {
                errorMsg.style.display = "block";
                msg.style.display = "none";
            }
        });

        select.addEventListener("change", function () {
            // Khi đổi coupon khác thì reset để người dùng bấm Apply lại
            btnApply.innerText = "Apply";
            btnApply.style.backgroundColor = "#cbfb45";
            btnApply.style.color = "#1a1b2f";
            msg.style.display = "none";
            calculateFinalTotal();
        });

        var paymentModal = document.getElementById("paymentModal");
        if (paymentModal) {
            paymentModal.addEventListener("hidden.bs.modal", resetCouponState);
        }
    });
</script>