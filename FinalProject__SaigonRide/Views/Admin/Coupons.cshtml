@model IEnumerable<FinalProject__SaigonRide.Models.Coupon>
@{
    ViewData["Title"] = "Admin – Coupons";
}

@section Styles {
    <style>
        /* ── Page header ── */
        .admin-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
        }
        .admin-header h2 {
            color: #d4ff00;
            font-weight: 700;
            font-size: 1.7rem;
            margin: 0;
        }
        .admin-header .subtitle {
            color: #8a8a9e;
            font-size: 0.85rem;
            margin-top: 2px;
        }

        /* ── Toast / Alert ── */
        .toast-neon {
            background: #1B1D2F;
            border: 1px solid #d4ff00;
            border-radius: 10px;
            color: #d4ff00;
            padding: 12px 20px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .toast-neon .close-toast {
            margin-left: auto;
            cursor: pointer;
            color: #8a8a9e;
            background: none;
            border: none;
            font-size: 1rem;
        }

        /* ── Search bar ── */
        .search-bar {
            background: #1B1D2F;
            border: 1px solid #2c2e3e;
            border-radius: 10px;
            padding: 0 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            width: 280px;
        }
        .search-bar input {
            background: transparent;
            border: none;
            outline: none;
            color: white;
            padding: 10px 0;
            font-size: 0.9rem;
            width: 100%;
        }
        .search-bar input::placeholder { color: #8a8a9e; }
        .search-bar svg { flex-shrink: 0; }

        /* ── Table card ── */
        .table-card {
            background: #1B1D2F;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #2c2e3e;
        }
        .table-card table {
            width: 100%;
            border-collapse: collapse;
            color: white;
        }
        .table-card thead th {
            background: #141627;
            color: #8a8a9e;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 16px 20px;
            font-weight: 600;
            border-bottom: 1px solid #2c2e3e;
        }
        .table-card tbody tr {
            border-bottom: 1px solid #2c2e3e;
            transition: background 0.2s;
        }
        .table-card tbody tr:last-child { border-bottom: none; }
        .table-card tbody tr:hover { background: #20223a; }
        .table-card tbody td {
            padding: 16px 20px;
            font-size: 0.92rem;
            vertical-align: middle;
        }

        /* ── ID & Status badges ── */
        .id-badge {
            background: #2c2e3e;
            color: #8a8a9e;
            border-radius: 6px;
            padding: 3px 10px;
            font-size: 0.8rem;
            font-family: monospace;
        }
        .status-badge {
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-badge.active { background: rgba(212,255,0,0.12); color: #d4ff00; }
        .status-badge.inactive { background: rgba(255,80,80,0.12); color: #ff5050; }

        /* ── Price chip ── */
        .price-chip {
            background: rgba(212, 255, 0, 0.12);
            color: #d4ff00;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
        }

        /* ── Buttons ── */
        .btn-neon {
            background: #d4ff00;
            color: #1a1a2e;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-neon:hover { opacity: 0.88; transform: translateY(-1px); }
        
        .btn-icon {
            background: #2c2e3e;
            border: none;
            border-radius: 8px;
            padding: 7px 10px;
            cursor: pointer;
            transition: background 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-icon.edit:hover  { background: rgba(212,255,0,0.18); }
        .btn-icon.delete:hover { background: rgba(255,80,80,0.18); }
        .btn-icon.edit svg   { stroke: #d4ff00; }
        .btn-icon.delete svg { stroke: #ff5050; }

        /* ── Empty state ── */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #8a8a9e;
        }
        .empty-state svg { margin-bottom: 16px; opacity: 0.4; }
        .empty-state p { margin: 0; font-size: 0.95rem; }

        /* ── Modal overlay ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10, 11, 22, 0.82);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.active { display: flex; }

        .modal-box {
            background: #1B1D2F;
            border: 1px solid #2c2e3e;
            border-radius: 18px;
            padding: 32px 36px;
            width: 100%;
            max-width: 440px;
            animation: modalIn 0.25s ease;
        }
        @@keyframes modalIn {
            from { transform: scale(0.92); opacity: 0; }
            to   { transform: scale(1); opacity: 1; }
        }
        .modal-box h4 {
            color: #d4ff00;
            font-weight: 700;
            font-size: 1.2rem;
            margin: 0 0 24px;
        }
        .modal-label {
            color: #8a8a9e;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
            display: block;
        }
        .modal-input {
            background: #141627;
            border: 1px solid #2c2e3e;
            border-radius: 10px;
            color: white;
            padding: 11px 14px;
            font-size: 0.92rem;
            width: 100%;
            outline: none;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }
        .modal-input:focus { border-color: #d4ff00; }
        .modal-footer {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
            margin-top: 28px;
        }
        .btn-ghost {
            background: #2c2e3e;
            border: none;
            color: #8a8a9e;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 0.88rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-ghost:hover { background: #353649; }

        /* ── Confirm delete modal ── */
        .confirm-text { color: #c0c0d0; font-size: 0.95rem; line-height: 1.6; margin-bottom: 0; }
        .confirm-text span { color: #d4ff00; font-weight: 600; }
        .btn-danger {
            background: #ff5050;
            border: none;
            color: white;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn-danger:hover { opacity: 0.85; }

        /* ── Stats bar ── */
        .stats-bar {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
        }
        .stat-pill {
            background: #1B1D2F;
            border: 1px solid #2c2e3e;
            border-radius: 12px;
            padding: 12px 20px;
            flex: 1;
        }
        .stat-pill .label { color: #8a8a9e; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; }
        .stat-pill .value { color: white; font-size: 1.5rem; font-weight: 700; margin-top: 2px; }
        .stat-pill .value span { color: #d4ff00; }

        /* ── Custom Neon Switch cho Trạng thái ── */
        .neon-switch { position: relative; display: inline-block; width: 42px; height: 22px; }
        .neon-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #2c2e3e; transition: .3s; border-radius: 20px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: #8a8a9e; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background-color: rgba(212,255,0,0.15); }
        input:checked + .slider:before { transform: translateX(20px); background-color: #d4ff00; }
        .switch-wrapper { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
        .switch-label { color: white; font-size: 0.9rem; font-weight: 500; }
    </style>
}

@* ── Toast notification ── *@
@if (TempData["Success"] != null)
{
    <div class="toast-neon" id="toastMsg">
        <svg width="16" height="16" fill="none" stroke="#d4ff00" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        @TempData["Success"]
        <button class="close-toast" onclick="document.getElementById('toastMsg').remove()">✕</button>
    </div>
}

@* ── Header ── *@
<div class="admin-header">
    <div>
        <h2>🎟️ Coupon Management</h2>
        <div class="subtitle">Quản lý các mã giảm giá trong hệ thống</div>
    </div>
    <button class="btn-neon" onclick="openAddModal()">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Add Coupon
    </button>
</div>

@* ── Stats ── *@
<div class="stats-bar">
    <div class="stat-pill">
        <div class="label">Total Coupons</div>
        <div class="value"><span>@Model.Count()</span></div>
    </div>
    <div class="stat-pill">
        <div class="label">Active Coupons</div>
        <div class="value">
            <span>@Model.Count(c => c.IsActive)</span>
        </div>
    </div>
    <div class="stat-pill">
        <div class="label">Highest Discount</div>
        <div class="value">
            <span>
                @(Model.Any() ? Model.Max(c => c.DiscountValue).ToString("#,##0") + " đ" : "—")
            </span>
        </div>
    </div>
</div>

@* ── Search + Table ── *@
<div class="search-bar mb-3" style="width:280px">
    <svg width="16" height="16" fill="none" stroke="#8a8a9e" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
    </svg>
    <input type="text" id="searchInput" placeholder="Search coupons…" oninput="filterTable()">
</div>

<div class="table-card">
    <table id="couponTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Mã Code</th>
                <th>Giảm giá</th>
                <th>Trạng thái</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <svg width="48" height="48" fill="none" stroke="#8a8a9e" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                            <p>Chưa có mã giảm giá nào.<br>Nhấn <strong>Add Coupon</strong> để tạo mới.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td><span class="id-badge">#@c.Id</span></td>
                    <td style="color: white; font-weight: bold; letter-spacing: 0.5px;">@c.CodeName</td>
                    <td><span class="price-chip">@c.DiscountValue.ToString("#,##0") đ</span></td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Disabled</span>
                        }
                    </td>
                    <td style="text-align:right">
                        <button class="btn-icon edit" title="Edit"
                                onclick="openEditModal('@c.Id', '@Html.Raw(c.CodeName)', @c.DiscountValue, @c.IsActive.ToString().ToLower())">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 1 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </button>
                        <button class="btn-icon delete ms-1" title="Delete"
                                onclick="openDeleteModal('@c.Id', '@Html.Raw(c.CodeName)')">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <polyline points="3 6 5 6 21 6"/><path stroke-linecap="round" d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                            </svg>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ─────────── MODAL: ADD ─────────── *@
<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <h4>➕ Add New Coupon</h4>
        <form method="post" asp-action="CreateCoupon" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="modal-label">Code Name</label>
                <input class="modal-input" name="CodeName" placeholder="e.g. SUMMER26" required autocomplete="off">
            </div>
            <div class="mb-3">
                <label class="modal-label">Discount Value (VND)</label>
                <input class="modal-input" name="DiscountValue" type="number" min="0" placeholder="e.g. 15000" required>
            </div>
            <div class="mb-3">
                <label class="modal-label">Status</label>
                <div class="switch-wrapper">
                    <label class="neon-switch">
                        <input type="checkbox" name="IsActive" value="true" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="switch-label">Kích hoạt ngay</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-ghost" onclick="closeModal('addModal')">Cancel</button>
                <button type="submit" class="btn-neon">Save Coupon</button>
            </div>
        </form>
    </div>
</div>

@* ─────────── MODAL: EDIT ─────────── *@
<div class="modal-overlay" id="editModal">
    <div class="modal-box">
        <h4>✏️ Edit Coupon</h4>
        <form method="post" asp-action="EditCoupon" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="Id">
            <div class="mb-3">
                <label class="modal-label">Code Name</label>
                <input class="modal-input" id="editCodeName" name="CodeName" required autocomplete="off">
            </div>
            <div class="mb-3">
                <label class="modal-label">Discount Value (VND)</label>
                <input class="modal-input" id="editDiscount" name="DiscountValue" type="number" min="0" required>
            </div>
            <div class="mb-3">
                <label class="modal-label">Status</label>
                <div class="switch-wrapper">
                    <label class="neon-switch">
                        <input type="checkbox" id="editIsActive" name="IsActive" value="true">
                        <span class="slider"></span>
                    </label>
                    <span class="switch-label">Kích hoạt</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-ghost" onclick="closeModal('editModal')">Cancel</button>
                <button type="submit" class="btn-neon">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@* ─────────── MODAL: DELETE ─────────── *@
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <h4>🗑️ Delete Coupon</h4>
        <p class="confirm-text">
            Bạn có chắc muốn xóa mã giảm giá <span id="deleteCouponName"></span>?
            Hành động này <strong>không thể hoàn tác</strong>.
        </p>
        <form method="post" asp-action="DeleteCoupon" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <input type="hidden" id="deleteId" name="id">
            <div class="modal-footer">
                <button type="button" class="btn-ghost" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="submit" class="btn-danger">Yes, Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ── Modal helpers ──
        function openAddModal() {
            document.getElementById('addModal').classList.add('active');
        }
        function openEditModal(id, codeName, discountValue, isActive) {
            document.getElementById('editId').value       = id;
            document.getElementById('editCodeName').value = codeName;
            document.getElementById('editDiscount').value = discountValue;
            document.getElementById('editIsActive').checked = isActive;
            document.getElementById('editModal').classList.add('active');
        }
        function openDeleteModal(id, codeName) {
            document.getElementById('deleteId').value           = id;
            document.getElementById('deleteCouponName').textContent = '"' + codeName + '"';
            document.getElementById('deleteModal').classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        // Close on backdrop click
        document.querySelectorAll('.modal-overlay').forEach(m => {
            m.addEventListener('click', e => { if (e.target === m) m.classList.remove('active'); });
        });

        // ── Search / filter ──
        function filterTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#couponTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        // ── Auto-dismiss toast ──
        setTimeout(() => {
            const t = document.getElementById('toastMsg');
            if (t) t.remove();
        }, 4000);
    </script>
}