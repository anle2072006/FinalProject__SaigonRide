@model IEnumerable<FinalProject__SaigonRide.Models.Vehicle>
@{
    ViewData["Title"] = "Admin – Vehicles";
}

@section Styles {
    <style>
        .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
        .admin-header h2 { color: #d4ff00; font-weight: 700; font-size: 1.7rem; margin: 0; }
        .subtitle { color: #8a8a9e; font-size: 0.85rem; }
        .toast-neon { background: #1B1D2F; border: 1px solid #d4ff00; border-radius: 10px; color: #d4ff00; padding: 12px 20px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        .table-card { background: #1B1D2F; border-radius: 16px; overflow: hidden; border: 1px solid #2c2e3e; }
        .table-card table { width: 100%; border-collapse: collapse; color: white; }
        .table-card th { background: #141627; color: #8a8a9e; font-size: 0.75rem; text-transform: uppercase; padding: 16px 20px; border-bottom: 1px solid #2c2e3e; }
        .table-card td { padding: 16px 20px; font-size: 0.92rem; border-bottom: 1px solid #2c2e3e; }
        .price-chip { background: rgba(212, 255, 0, 0.12); color: #d4ff00; border-radius: 20px; padding: 4px 12px; font-weight: 600; }
        .btn-neon { background: #d4ff00; color: #1a1a2e; border: none; border-radius: 8px; padding: 10px 20px; font-weight: 700; cursor: pointer; }
        .btn-action { background: #2c2e3e; color: #d4ff00; padding: 6px 12px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; margin-right: 5px; }
        .btn-action.delete { background: #ff5050; color: white; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(10, 11, 22, 0.85); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: #1B1D2F; border: 1px solid #2c2e3e; border-radius: 18px; padding: 30px; width: 100%; max-width: 450px; }
        .modal-input { background: #141627; border: 1px solid #2c2e3e; border-radius: 10px; color: white; padding: 12px; width: 100%; outline: none; margin-bottom: 15px; }
        .modal-label { color: #8a8a9e; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; display: block; }
    </style>
}

@if (TempData["Success"] != null)
{
    <div class="toast-neon" id="toastMsg">@TempData["Success"]</div>
}

<div class="admin-header">
    <div>
        <h2>⚡ Vehicle Management</h2>
        <div class="subtitle">Manage and allocate vehicles to stations</div>
    </div>
    <button class="btn-neon" onclick="openAddModal()">+ Add Vehicles</button>
</div>

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Vehicle Name</th>
                <th>Price (VND/min)</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td><small style="color:#8a8a9e">#@v.Id.Substring(0,8)...</small></td>
                    <td>@v.Name</td>
                    <td><span class="price-chip">@v.PricePerHour.ToString("N0") VND</span></td>
                    <td style="text-align:right">
                        <button class="btn-action" 
                                onclick='openEditModal("@v.Id", "@Html.Raw(v.Name)", @v.PricePerHour.ToString(System.Globalization.CultureInfo.InvariantCulture), "@v.StationId")'>
                            Edit
                        </button>

                        <button class="btn-action delete" 
                                onclick="openDeleteModal('@v.Id', '@Html.Raw(v.Name)')">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ─────────── MODAL: ADD ─────────── *@
<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <h4 style="color:#d4ff00; margin-bottom:20px">➕ Add New Vehicles</h4>
        <form method="post" asp-action="CreateVehicle" asp-controller="Admin">
            @Html.AntiForgeryToken()
            
            <label class="modal-label">Assign to Station</label>
            <select class="modal-input" name="StationId" required>
                <option value="">-- Select Station --</option>
                @if (ViewBag.Stations != null)
                {
                    foreach (var station in (IEnumerable<FinalProject__SaigonRide.Models.Station>)ViewBag.Stations)
                    {
                        <option value="@station.Id">@station.Name</option>
                    }
                }
            </select>

            <label class="modal-label">Vehicle Type</label>
            <input class="modal-input" name="Name" placeholder="e.g. Electric Scooter" required>

            <div style="display:flex; gap:15px">
                <div style="flex:1">
                    <label class="modal-label">Price (VND/min)</label>
                    <input class="modal-input" name="PricePerHour" type="number" step="any" value="1500" required>
                </div>
                <div style="flex:1">
                    <label class="modal-label">Quantity</label>
                    <input class="modal-input" name="Quantity" type="number" min="1" value="1" required>
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:10px">
                <button type="button" class="btn-neon" style="background:#2c2e3e; color:#8a8a9e" onclick="closeModal('addModal')">Cancel</button>
                <button type="submit" class="btn-neon">Create Vehicles</button>
            </div>
        </form>
    </div>
</div>

@* ─────────── MODAL: DELETE ─────────── *@
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <h4 style="color:#ff5050">🗑️ Confirm Delete</h4>
        <p style="color:#8a8a9e">Are you sure you want to delete <span id="delName" style="color:#fff; font-weight:bold;"></span>?</p>
        <form method="post" asp-action="DeleteVehicle" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <input type="hidden" id="delId" name="id">
            <div style="display:flex; justify-content:flex-end; gap:10px">
                <button type="button" class="btn-neon" style="background:#2c2e3e; color:#8a8a9e" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="submit" class="btn-neon" style="background:#ff5050; color:#fff">Delete</button>
            </div>
        </form>
    </div>
</div>

@* ─────────── MODAL: EDIT VEHICLE ─────────── *@
<div class="modal-overlay" id="editVehicleModal">
    <div class="modal-box">
        <h4 style="color:#d4ff00; margin-bottom:20px">✏️ Edit Vehicle</h4>
        <form method="post" asp-action="EditVehicle" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editVehicleId" name="Id">

            <div class="mb-3">
                <label class="modal-label">Vehicle Name</label>
                <input class="modal-input" id="editVehicleName" name="Name" required autocomplete="off">
            </div>

            <div class="mb-3">
                <label class="modal-label">Price (VND/MIN)</label>
                <input type="number" step="any" class="modal-input" id="editVehiclePrice" name="PricePerHour" required autocomplete="off">
            </div>

            <div class="mb-3">
                <label class="modal-label">Station (Trạm)</label>
                <select class="modal-input" id="editVehicleStation" name="StationId" required>
                    <option value="">-- Chọn Trạm --</option>
                    @if (ViewBag.Stations != null)
                    {
                        foreach (var station in (IEnumerable<FinalProject__SaigonRide.Models.Station>)ViewBag.Stations)
                        {
                            <option value="@station.Id">@station.Name</option>
                        }
                    }
                </select>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px">
                <button type="button" class="btn-neon" style="background:#2c2e3e; color:#8a8a9e" onclick="closeModal('editVehicleModal')">Cancel</button>
                <button type="submit" class="btn-neon">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal() { document.getElementById('addModal').classList.add('active'); }
        
        function openEditModal(id, name, price, stationId) {
            document.getElementById('editVehicleId').value = id;
            document.getElementById('editVehicleName').value = name;
            document.getElementById('editVehiclePrice').value = price;

            const stationSelect = document.getElementById('editVehicleStation');
            if (stationSelect) {
                stationSelect.value = stationId;
            }

            document.getElementById('editVehicleModal').classList.add('active');
        }
        
        function openDeleteModal(id, name) { 
            document.getElementById('delId').value = id;
            document.getElementById('delName').innerText = name;
            document.getElementById('deleteModal').classList.add('active'); 
        }
        
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }
        
        setTimeout(() => { document.getElementById('toastMsg')?.remove(); }, 4000);
    </script>
}