@model IEnumerable<FinalProject__SaigonRide.Models.Vehicle>
@{
    ViewData["Title"] = "Select Vehicle";

}

<div class="main-content vehicle-page">

    <div class="search-container">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Search..." />
        </div>
        <button class="btn-search">Search</button>
    </div>

    <div class="blue-outline-box" style="border: none; background: transparent;">
        @if (Model != null && Model.Any())
        {
            @foreach (var vehicle in Model)
            {
                <div class="vehicle-card" style="display: flex; align-items: center; padding: 15px 25px; background-color: #1a1b2f; border-radius: 12px; margin-bottom: 15px;">
                    
                    <img src="@(string.IsNullOrEmpty(vehicle.ImagePath) ? "/images/escooter.jpg" : vehicle.ImagePath)"
                         alt="@vehicle.Name" class="vehicle-img" style="width: 80px; height: 80px; border-radius: 8px; object-fit: cover; margin-right: 25px; flex-shrink: 0;" />

                    <div class="vehicle-info" style="display: flex; justify-content: space-between; align-items: center; flex: 1;">
                        
                        <div style="flex: 1; text-align: left;">
                            <h4 style="margin: 0; font-size: 1.15rem; font-weight: bold; color: #ffffff;">@vehicle.Name</h4>
                            <span style="font-size: 0.85rem; font-weight: bold; color: #51b56d; display: block; margin-top: 5px;">Available</span>
                        </div>
                        
                        <div style="flex: 1; text-align: center;">
                            <span style="font-size: 1rem; font-weight: bold; color: #ffffff;">@vehicle.PricePerHour.ToString("N0") VND/h</span>
                        </div>
                    </div>

                    <button type="button" class="btn-book"
                            style="margin-left: 20px; flex-shrink: 0;"
                            data-bs-toggle="modal"
                            data-bs-target="#confirmModal"
                            data-vehicleid="@vehicle.Id"
                            data-vehiclename="@vehicle.Name">
                        Book
                    </button>
                </div>
            }
        }
        else
        {
            <div style="width: 100%; text-align: center; padding: 40px 20px; background-color: #1a1b2f; border-radius: 12px;">
                <p style="color: #D1F366; font-size: 1.1rem; font-weight: bold; text-shadow: 0 0 8px rgba(209, 243, 102, 0.3); margin: 0;">
                    Hiện tại trạm này đang hết xe.<br>Vui lòng chọn một trạm khác nhé!
                </p>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #1a1a2e; color: #fff; border: 1px solid #D1F366;">
            <div class="modal-header" style="border-bottom: 1px solid #333;">
                <h5 class="modal-title" style="color: #D1F366; font-weight: bold;">Xác nhận chuyến đi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Bạn đã chọn thông tin sau:</p>

                <div style="background: #222; padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #444;">
                    <p class="mb-2">📍 <strong>Trạm:</strong> <span style="color: #D1F366;">@ViewBag.StationName</span></p>
                    <p class="mb-0">🛴 <strong>Xe:</strong> <span id="displayVehicleName" style="color: #D1F366;"></span> <span class="text-secondary">(ID: <span id="displayVehicleId"></span>)</span></p>
                </div>

                <p class="text-warning" style="font-size: 0.9rem;">
                    <em>Ghi chú: Bấm "Go to In Use" để chuyển trang và theo dõi chuyến đi của bạn.</em>
                </p>

                <form asp-controller="InUse" asp-action="StartTrip" method="post">
                    <input type="hidden" name="stationId" value="@ViewBag.StationId" />
                    <input type="hidden" name="vehicleId" id="inputModalVehicleId" />

                    <button type="submit" class="btn w-100 mt-2" style="background-color: #D1F366; color: black; font-weight: bold; border-radius: 8px; padding: 10px;">
                        Go to In Use ➔
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/vehicle.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        // Script nhỏ để bắt sự kiện khi Popup mở lên và truyền dữ liệu xe vào Popup
        document.addEventListener('DOMContentLoaded', function () {
            var confirmModal = document.getElementById('confirmModal');

            if (confirmModal) {
                confirmModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;

                    // Lấy dữ liệu thật từ nút Book
                    var vehicleId = button.getAttribute('data-vehicleid');
                    var vehicleName = button.getAttribute('data-vehiclename');

                    // Hiển thị lên màn hình
                    document.getElementById('displayVehicleName').textContent = vehicleName;
                    document.getElementById('displayVehicleId').textContent = vehicleId;

                    // Gắn vào form gửi đi
                    document.getElementById('inputModalVehicleId').value = vehicleId;
                });
            }
        });
    </script>
}