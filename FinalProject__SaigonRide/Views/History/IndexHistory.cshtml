@model IEnumerable<FinalProject__SaigonRide.Models.TransactionHistory>

@{
    ViewData["Title"] = "History";
}
@section Styles {
    <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" />
}
<div class="main-content">
    <div class="table-container">
        <table class="history-table">
            <thead>
                <tr>
                    <th>Mã giao dịch</th>
                    <th>Nội dung</th>
                    <th>Phương thức</th>
                    <th>Số tiền</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="row-gray">
                            <td>@item.TransactionNo</td>
                            <td>@item.OrderDescription</td>
                            <td>
                                <span style="font-weight: bold; color: #cbfb45;">@item.PaymentMethod</span>
                            </td>
                            <td>@item.Amount.ToString("#,##0") VND</td>
                            <td>@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.Status == "Success")
                                {
                                    <span style="color: #51b56d; font-weight: bold;">Thành công</span>
                                }
                                else
                                {
                                    <span style="color: #ff4d4d; font-weight: bold;">Thất bại</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 20px;">Bạn chưa có giao dịch nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>